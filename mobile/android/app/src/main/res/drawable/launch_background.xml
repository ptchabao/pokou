<?xml version="1.0" encoding="utf-8"?>
<!-- Repli pour les versions d'Android antérieures à drawable-v21. Même
     couleur, même raison : voir drawable-v21/launch_background.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/pokou_launch_background" />
    <!-- Le logo officiel, centré (Android 11 et avant ; à partir
         d'Android 12, le système affiche l'icône de l'application). -->
    <item>
        <bitmap android:gravity="center" android:src="@drawable/launch_logo" />
    </item>
</layer-list>
