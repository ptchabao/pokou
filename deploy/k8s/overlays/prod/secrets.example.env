# Copier en secrets.env (ignoré par git), remplir, puis déployer.
# Chaque valeur vide ici est OBLIGATOIRE en production, sauf mention.
SECRET_KEY=
WEBHOOK_HMAC_SECRET=
DATABASE_URL=postgresql+psycopg://pokou:MOT_DE_PASSE@HOTE:5432/pokou?sslmode=require
REDIS_URL=rediss://:MOT_DE_PASSE@HOTE:6379/0
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_API_URL=https://api.pok.app
# SMS des codes : Twilio (principal). TWILIO_SMS_FROM ou TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# NGH : secours, facultatif.
NGH_API_KEY=
NGH_API_SECRET=
SMS_SENDER_ID=POKOU
FIREBASE_CREDENTIALS_JSON=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://VOTRE-PROJET.livekit.cloud
ANDROID_PLAY_SIGNING_SHA256=
APPLE_TEAM_ID=
# Mot de passe généré par Strimzi (Secret pokou-api, namespace kafka).
KAFKA_SASL_PASSWORD=
