# Copier en secrets.env (ignoré par git), remplir, puis lancer render.sh.
# Chaque valeur vide est OBLIGATOIRE en production, sauf mention.
SECRET_KEY=
WEBHOOK_HMAC_SECRET=
# Addon PostgreSQL de Kubero ou base gérée. Le mot de passe encodé (%40 pour @).
DATABASE_URL=postgresql+psycopg://pokou:MOT_DE_PASSE@HOTE:5432/pokou?sslmode=require
REDIS_URL=redis://:MOT_DE_PASSE@HOTE:6379/0
# Obligatoire sous Kubero : le système de fichiers des pods est en lecture
# seule et éphémère, les pièces jointes doivent aller dans S3.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
PUBLIC_API_URL=https://api.pok.app
PUBLIC_LINK_BASE_URL=https://apipokou.cabinet-p-et-associes.com
# SMS des codes : Twilio. TWILIO_SMS_FROM ou TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# NGH : secours, facultatif.
NGH_API_KEY=
NGH_API_SECRET=
SMS_SENDER_ID=POKOU
FIREBASE_CREDENTIALS_JSON=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://VOTRE-PROJET.livekit.cloud
# Empreinte de la clé de signature Play (pas la clé d'upload).
ANDROID_PLAY_SIGNING_SHA256=
# Team ID Apple à 10 caractères, requis pour Universal Links iOS.
APPLE_TEAM_ID=
# Kafka (facultatif) : mot de passe généré par Strimzi, et le certificat de
# l'autorité sur UNE ligne, sauts de ligne écrits \n :
#   kubectl -n kafka get secret pokou-kafka-cluster-ca-cert \
#     -o jsonpath='{.data.ca\.crt}' | base64 -d | awk '{printf "%s\\n", $0}'
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_PEM=
