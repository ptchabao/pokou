# Réglages NON secrets de l'API sous Kubero. Les secrets vont dans
# secrets.env (même liste que deploy/k8s/overlays/prod/secrets.example.env).
ENVIRONMENT=production
# Les pods web migrent au démarrage, sous verrou PostgreSQL (alembic/env.py) :
# Kubero n'a pas de Job à jouer AVANT le déploiement.
RUN_MIGRATIONS=1
UVICORN_WORKERS=2
FORWARDED_ALLOW_IPS=*
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
S3_BUCKET=pokou-media
S3_REGION=eu-west-1
FCM_ENABLED=true
LIVEKIT_ENABLED=true
# Kafka (Strimzi, deploy/k8s/kafka) : vider KAFKA_BOOTSTRAP_SERVERS et mettre
# WORKER_REPLICAS=0 dans render.sh si Kafka n'est pas installé. Le
# certificat de l'autorité va dans secrets.env (KAFKA_SSL_CA_PEM) : Kubero
# ne monte pas de fichier depuis un Secret.
KAFKA_BOOTSTRAP_SERVERS=pokou-kafka-kafka-bootstrap.kafka.svc:9093
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=pokou-api
KAFKA_TOPIC_PREFIX=pokou
