# ── Pokou API — exemple de configuration ────────────────────────────────────
# Copier en `.env` et remplir. Toutes les variables sont facultatives en
# développement ; en production, l'API REFUSE de démarrer tant que
# SECRET_KEY et WEBHOOK_HMAC_SECRET gardent leur valeur par défaut.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Base de données (SQLite par défaut ; PostgreSQL en production)
DATABASE_URL=postgresql://pokou:pokou@localhost:5432/pokou
REDIS_URL=redis://localhost:6379/0

# Sécurité — générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
WEBHOOK_HMAC_SECRET=

# CORS / hôtes autorisés (listes JSON)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3002"]
ALLOWED_HOSTS=["*"]

# Codes de connexion : SMS (NGH) et WhatsApp
NGH_API_KEY=
NGH_API_SECRET=
# Doit être déclaré chez l'opérateur avant usage.
SMS_SENDER_ID=POKOU
WHATSAPP_SERVICE_URL=
WHATSAPP_GATEWAY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Compte de démonstration pour la revue des stores — à VIDER après la revue.
REVIEW_PHONE_NUMBERS=
REVIEW_OTP_CODE=

# Pièces jointes : disque local par défaut, S3/MinIO dès que renseigné
MEDIA_STORAGE_DIR=./media_storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pokou-media

# Appels (LiveKit Cloud)
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Notifications push (Firebase Cloud Messaging)
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=

# Mode Bouclier : modèles de langage (Ollama local, secours cloud)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_ENABLED=false
GEMINI_API_KEY=
GROQ_ENABLED=false
GROQ_API_KEY=
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
GROK_ENABLED=false
GROK_API_KEY=
